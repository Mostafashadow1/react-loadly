{
  "name": "react-loadly",
  "version": "3.1.0",
  "type": "module",
  "description": "Accessible React loaders, spinners and skeleton screens with loading-state hooks. 30+ loaders, SkeletonLoader, SSR and Next.js ready, TypeScript.",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/types",
    "AGENTS.md",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./components": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks/index.d.ts",
        "default": "./dist/hooks/index.esm.js"
      },
      "require": {
        "types": "./dist/hooks/index.d.cts",
        "default": "./dist/hooks/index.cjs"
      }
    },
    "./skeleton": {
      "import": {
        "types": "./dist/skeleton/index.d.ts",
        "default": "./dist/skeleton/index.esm.js"
      },
      "require": {
        "types": "./dist/skeleton/index.d.cts",
        "default": "./dist/skeleton/index.cjs"
      }
    },
    "./loaders": {
      "import": {
        "types": "./dist/loaders/index.d.ts",
        "default": "./dist/loaders/index.esm.js"
      },
      "require": {
        "types": "./dist/loaders/index.d.cts",
        "default": "./dist/loaders/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "build:js": "node scripts/generate-css-string.js && rollup -c",
    "build:types": "tsc --emitDeclarationOnly",
    "build:watch": "rollup -c -w",
    "clean": "rimraf dist",
    "build": "pnpm clean && pnpm build:js && pnpm build:types",
    "build:analyze": "pnpm build && pnpm analyze",
    "analyze": "rollup -c --config-option analyze=true",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "prepare": "pnpm build",
    "production": "pnpm i && pnpm lint:fix && pnpm build && pnpm pack && npm publish --access public"
  },
  "keywords": [
    "react",
    "nextjs",
    "loader",
    "spinner",
    "skeleton",
    "skeleton-loader",
    "loading",
    "loading-indicator",
    "loading-state",
    "placeholder",
    "suspense-fallback",
    "accessible",
    "a11y",
    "typescript",
    "ssr"
  ],
  "author": {
    "name": "Mostafa Mohamed Abdalla",
    "url": "https://shadow-coding.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mostafashadow1/react-loadly.git",
    "directory": "packages/react-loadly"
  },
  "bugs": {
    "url": "https://github.com/Mostafashadow1/react-loadly/issues"
  },
  "homepage": "https://mostafashadow1.github.io/react-loadly/",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^24.3.1",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.6.1",
    "rollup-plugin-dts": "^6.2.3",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "rollup-plugin-visualizer": "^5.9.2",
    "ts-jest": "^29.1.1",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
